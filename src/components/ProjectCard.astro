---
import { withBase } from '../config/site';

interface Props {
  id: string;
  title: string;
  summary: string;
  category: string;
  tags: string[];
  year: string;
  status?: 'Active' | 'Completed' | 'Experiment';
  repoUrl?: string;
  demoUrl?: string;
  hasWriteup?: boolean;
}

const {
  id,
  title,
  summary,
  category,
  tags,
  year,
  status = 'Completed',
  repoUrl,
  demoUrl,
  hasWriteup = false,
} = Astro.props;

const primaryHref = hasWriteup
  ? withBase(`/projects/${id}`)
  : demoUrl || repoUrl || withBase(`/projects/${id}`);
const isPrimaryExternal = !hasWriteup && Boolean(demoUrl || repoUrl);

const statusClass =
  status === 'Active'
    ? 'badge--green'
    : status === 'Experiment'
      ? 'badge--gold'
      : 'badge--navy';
---

<article class="project-card" data-category={category}>
  <div class="project-card__meta">
    <span class="project-card__category">{category}</span>
    <div class="project-card__badges">
      <span class:list={['badge', statusClass]}>{status}</span>
      <span class="project-card__year">{year}</span>
    </div>
  </div>

  <h3 class="project-card__title">
    <a
      href={primaryHref}
      target={isPrimaryExternal ? '_blank' : undefined}
      rel={isPrimaryExternal ? 'noopener noreferrer' : undefined}
    >
      {title}
      {isPrimaryExternal && <span class="ext-arrow" aria-hidden="true">↗</span>}
    </a>
  </h3>

  <p class="project-card__summary">{summary}</p>

  <div class="project-card__footer">
    {
      tags.length > 0 && (
        <ul class="tag-list" aria-label="Project technologies and topics">
          {tags.map((tag) => (
            <li class="tag-item">{tag}</li>
          ))}
        </ul>
      )
    }

    <div class="project-card__actions">
      {
        hasWriteup && (
          <a href={withBase(`/projects/${id}`)} class="action-link action-link--primary">
            Read write-up →
          </a>
        )
      }
      {
        repoUrl && (
          <a href={repoUrl} target="_blank" rel="noopener noreferrer" class="action-link">
            GitHub ↗
          </a>
        )
      }
      {
        demoUrl && (
          <a href={demoUrl} target="_blank" rel="noopener noreferrer" class="action-link">
            Live Demo ↗
          </a>
        )
      }
    </div>
  </div>
</article>

<style>
  .project-card {
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-md);
    padding: 1.5rem 1.6rem;
    transition: border-color var(--transition-fast), transform var(--transition-fast), box-shadow var(--transition-fast);
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .project-card:hover {
    border-color: var(--border-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow-subtle);
  }

  .project-card__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .project-card__category {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--accent-green);
    font-weight: 500;
  }

  .project-card__badges {
    display: flex;
    align-items: center;
    gap: 0.55rem;
  }

  .project-card__year {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .project-card__title {
    font-size: 1.3rem;
    line-height: 1.3;
  }

  .project-card__title a:hover {
    color: var(--accent-green);
  }

  .ext-arrow {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    margin-left: 0.25rem;
    color: var(--text-muted);
  }

  .project-card__summary {
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-secondary);
  }

  .project-card__footer {
    margin-top: 0.4rem;
    padding-top: 0.85rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .project-card__actions {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    margin-left: auto;
  }

  .action-link {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
    font-weight: 500;
  }

  .action-link:hover {
    color: var(--text-primary);
  }

  .action-link--primary {
    color: var(--accent-green);
  }

  .action-link--primary:hover {
    color: var(--accent-gold);
  }
</style>
