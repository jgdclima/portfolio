---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GeometricMotif from '../../components/GeometricMotif.astro';
import { SITE, withBase } from '../../config/site';

export async function getStaticPaths() {
  const posts = (await getCollection('blog')).filter(
    (post) => !post.data.draft && !post.data.externalUrl
  );
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const formattedDate = post.data.pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const badgeClass =
  post.data.category === 'Game Design'
    ? 'badge--green'
    : post.data.category === 'Fiction & Literature'
      ? 'badge--gold'
      : 'badge--navy';
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  narrow={true}
>
  <article class="essay-article">
    <header class="essay-header">
      <a href={withBase('/blog')} class="back-link">← All essays & reviews</a>

      <div class="essay-meta">
        <span class:list={['badge', badgeClass]}>{post.data.category}</span>
        <time datetime={post.data.pubDate.toISOString()} class="essay-date">
          {formattedDate}
        </time>
        {post.data.readingTime && <span class="essay-date">· {post.data.readingTime}</span>}
      </div>

      <h1 class="essay-title">{post.data.title}</h1>
      <p class="essay-subtitle">{post.data.description}</p>

      {
        post.data.subjectTitle && (
          <div class="subject-callout">
            <span class="subject-callout__kicker">
              {post.data.category === 'Game Design' ? 'Work Examined' : 'Book / Work Reviewed'}
            </span>
            <p class="subject-callout__work">
              <strong>{post.data.subjectTitle}</strong>
              {post.data.subjectCreator && <span> — {post.data.subjectCreator}</span>}
            </p>
          </div>
        )
      }
    </header>

    <div class="prose">
      <Content />
    </div>

    <GeometricMotif variant="divider" />

    <footer class="essay-footer">
      <p class="essay-author">
        Written by <strong>{SITE.name}</strong>
      </p>
      <a href={withBase('/blog')} class="back-link">← Back to all essays</a>
    </footer>
  </article>
</BaseLayout>

<style>
  .essay-header {
    padding-bottom: 1.75rem;
    margin-bottom: 2.25rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .back-link:hover {
    color: var(--accent-green);
  }

  .essay-meta {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    margin-bottom: 0.9rem;
    flex-wrap: wrap;
  }

  .essay-date {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .essay-title {
    margin-bottom: 0.85rem;
    line-height: 1.18;
  }

  .essay-subtitle {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    font-style: italic;
    color: var(--text-muted);
    line-height: 1.55;
    margin-bottom: 1.25rem;
  }

  .subject-callout {
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-left: 3px solid var(--accent-green);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: 0.85rem 1.15rem;
  }

  .subject-callout__kicker {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-green);
    margin-bottom: 0.2rem;
  }

  .subject-callout__work {
    font-size: 0.94rem;
    color: var(--text-primary);
  }

  .essay-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 1rem;
    border-top: 1px solid var(--border-subtle);
  }

  .essay-author {
    font-size: 0.9rem;
    color: var(--text-secondary);
  }
</style>
