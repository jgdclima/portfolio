---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { withBase } from '../../config/site';

let projects: any[] = [];
try {
  projects = (await getCollection('projects')).sort(
    (a, b) => a.data.order - b.data.order
  );
} catch (_) {}

const categories = ['All', ...Array.from(new Set(projects.map((p) => p.data.category)))];
---

<BaseLayout
  title="Personal Projects"
  description="Software prototypes, narrative tools, and interactive systems experiments by João Lima."
>
  <header class="page-header">
    <a href={withBase('/')} class="back-link" id="projects-back-home">← Back to overview</a>
    <span class="section-kicker">01 · Directory</span>
    <h1 class="page-title">Personal Projects</h1>
    <p class="page-lead">
      A curated index of software systems, narrative design tools, and interactive prototypes. Each project links either to an on-site design write-up or directly to the source repository.
    </p>

    {
      categories.length > 2 && (
        <div class="filter-bar" role="toolbar" aria-label="Filter projects by category">
          {categories.map((cat, idx) => (
            <button
              type="button"
              id={`project-filter-${cat.toLowerCase().replace(/[^a-z0-9]/g, '-')}`}
              class:list={['filter-btn', { 'filter-btn--active': idx === 0 }]}
              data-filter={cat}
            >
              {cat}
            </button>
          ))}
        </div>
      )
    }
  </header>

  {
    projects.length > 0 ? (
      <section class="projects-grid" id="projects-list" aria-label="Projects list">
        {
          projects.map((project) => (
            <ProjectCard
              id={project.id}
              title={project.data.title}
              summary={project.data.summary}
              category={project.data.category}
              tags={project.data.tags}
              year={project.data.year}
              status={project.data.status}
              repoUrl={project.data.repoUrl}
              demoUrl={project.data.demoUrl}
              hasWriteup={project.data.hasWriteup}
            />
          ))
        }
      </section>
    ) : (
      <section class="empty-state-card" aria-label="No projects published yet">
        <div class="empty-state-card__badge">Work in progress</div>
        <h2 class="empty-state-card__title">Projects in Development</h2>
        <p class="empty-state-card__text">
          I am currently working on software tools, narrative engines, and game mechanics prototypes. As projects reach a milestone or are open-sourced, detailed write-ups and links will be added here.
        </p>
        <div class="empty-state-card__cta">
          <a href="https://github.com/jgdclima" target="_blank" rel="noopener noreferrer" class="action-btn">
            View repositories on GitHub ↗
          </a>
        </div>
      </section>
    )
  }
</BaseLayout>

<script is:inline>
  (() => {
    const buttons = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('#projects-list .project-card');
    if (!buttons.length || !cards.length) return;

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        buttons.forEach((b) => b.classList.remove('filter-btn--active'));
        btn.classList.add('filter-btn--active');

        cards.forEach((card) => {
          const cat = card.getAttribute('data-category');
          if (filter === 'All' || cat === filter) {
            card.style.display = '';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  })();
</script>

<style>
  .page-header {
    padding-bottom: 2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .back-link {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
    margin-bottom: 1.25rem;
  }

  .back-link:hover {
    color: var(--accent-green);
  }

  .page-title {
    margin-top: 0.3rem;
    margin-bottom: 0.75rem;
  }

  .page-lead {
    font-size: 1.04rem;
    max-width: 68ch;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .filter-bar {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .filter-btn {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    padding: 0.4rem 0.8rem;
    border-radius: var(--radius-sm);
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-muted);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    color: var(--text-primary);
    border-color: var(--border-strong);
  }

  .filter-btn--active {
    background-color: var(--accent-green-soft);
    border-color: var(--accent-green);
    color: var(--accent-green);
    font-weight: 500;
  }

  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
  }

  .empty-state-card {
    background-color: var(--bg-elevated);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-md);
    padding: 2.25rem 2rem;
    max-width: 680px;
  }

  .empty-state-card__badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-green);
    background-color: var(--accent-green-soft);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    margin-bottom: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .empty-state-card__title {
    font-family: var(--font-serif);
    font-size: 1.45rem;
    margin-bottom: 0.65rem;
  }

  .empty-state-card__text {
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 1.4rem;
  }

  .action-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    background-color: var(--bg-primary);
    border: 1px solid var(--border-strong);
    color: var(--text-primary);
  }

  .action-btn:hover {
    border-color: var(--accent-green);
    color: var(--accent-green);
  }
</style>
