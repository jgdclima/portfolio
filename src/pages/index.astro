---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import GeometricMotif from '../components/GeometricMotif.astro';
import ProjectCard from '../components/ProjectCard.astro';
import BlogCard from '../components/BlogCard.astro';
import { SITE, withBase } from '../config/site';

let allProjects: any[] = [];
try {
  allProjects = (await getCollection('projects')).sort(
    (a, b) => a.data.order - b.data.order
  );
} catch (_) {}
const featuredProjects = allProjects.filter((p) => p.data.featured).slice(0, 3);

let allPosts: any[] = [];
try {
  allPosts = (await getCollection('blog'))
    .filter((post) => !post.data.draft)
    .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
} catch (_) {}
const recentPosts = allPosts.slice(0, 3);
---

<BaseLayout>
  {/* Hero / High-Level Overview */}
  <section class="hero" aria-labelledby="hero-heading">
    <p class="hero__kicker">{SITE.location}</p>
    <h1 id="hero-heading" class="hero__title">{SITE.name}</h1>
    <p class="hero__subtitle">{SITE.role}</p>

    <div class="hero__bio">
      {SITE.bioParagraphs.map((paragraph) => <p>{paragraph}</p>)}
    </div>

    {/* Focus Pillars */}
    <div class="pillars-grid" aria-label="Core areas of focus">
      {
        SITE.interests.map((item, idx) => (
          <div class="pillar-item">
            <span class="pillar-index">0{idx + 1}</span>
            <div>
              <h2 class="pillar-title">{item.label}</h2>
              <p class="pillar-detail">{item.detail}</p>
            </div>
          </div>
        ))
      }
    </div>

    {/* Social & Contact Strip */}
    <div class="socials-bar" aria-label="Social and external profiles">
      <span class="socials-bar__label">Elsewhere:</span>
      <ul class="socials-list">
        {
          SITE.socials.map((social) => (
            <li>
              <a
                href={social.href}
                id={`hero-social-${social.label.toLowerCase()}`}
                class="social-pill"
                target={social.external ? '_blank' : undefined}
                rel={social.external ? 'noopener noreferrer' : undefined}
              >
                <span>{social.label}</span>
                {social.external && <span aria-hidden="true">↗</span>}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* Primary Gateway Pathways */}
  <section aria-label="Explore site sections" class="gateway-grid">
    <a href={withBase('/projects')} class="gateway-card" id="gateway-projects">
      <div>
        <div class="gateway-card__top">
          <span class="badge badge--green">01 · Directory</span>
          <span class="gateway-card__count">{allProjects.length > 0 ? `${allProjects.length} Projects` : 'Directory'}</span>
        </div>
        <h2 class="gateway-card__title">Personal Projects</h2>
        <p class="gateway-card__desc">
          Software prototypes, narrative tools, and interactive systems experiments—linking to source code and design notes.
        </p>
      </div>
      <span class="gateway-card__cta">
        Explore projects <span class="gateway-card__arrow" aria-hidden="true">→</span>
      </span>
    </a>

    <a href={withBase('/blog')} class="gateway-card gateway-card--gold" id="gateway-blog">
      <div>
        <div class="gateway-card__top">
          <span class="badge badge--gold">02 · Notebook</span>
          <span class="gateway-card__count">{allPosts.length > 0 ? `${allPosts.length} Essays` : 'Notebook'}</span>
        </div>
        <h2 class="gateway-card__title">Essays & Reviews</h2>
        <p class="gateway-card__desc">
          Short critical essays on game design mechanics and fiction literature reviews—hosted in Markdown or on Substack & Medium.
        </p>
      </div>
      <span class="gateway-card__cta">
        Read the blog <span class="gateway-card__arrow" aria-hidden="true">→</span>
      </span>
    </a>
  </section>

  <GeometricMotif variant="divider" />

  {/* Featured Personal Projects Preview */}
  {
    featuredProjects.length > 0 ? (
      <section class="home-section" aria-labelledby="featured-projects-heading">
        <div class="section-header">
          <div>
            <span class="section-kicker">Selected Work</span>
            <h2 id="featured-projects-heading" class="section-title">Featured Projects</h2>
          </div>
          <a href={withBase('/projects')} class="section-link" id="view-all-projects-link">
            View all projects ({allProjects.length}) →
          </a>
        </div>

        <div class="projects-stack">
          {
            featuredProjects.map((project) => (
              <ProjectCard
                id={project.id}
                title={project.data.title}
                summary={project.data.summary}
                category={project.data.category}
                tags={project.data.tags}
                year={project.data.year}
                status={project.data.status}
                repoUrl={project.data.repoUrl}
                demoUrl={project.data.demoUrl}
                hasWriteup={project.data.hasWriteup}
              />
            ))
          }
        </div>
      </section>
    ) : (
      <section class="home-section home-section--empty">
        <div class="section-header">
          <div>
            <span class="section-kicker">Selected Work</span>
            <h2 id="featured-projects-heading" class="section-title">Projects in Progress</h2>
          </div>
        </div>
        <div class="empty-state-box">
          <p class="empty-state-box__text">
            Currently working on software experiments, narrative prototypes, and interactive systems. Projects will be catalogued here as they launch.
          </p>
          <a href="https://github.com/jgdclima" target="_blank" rel="noopener noreferrer" class="section-link">
            Follow recent code activity on GitHub ↗
          </a>
        </div>
      </section>
    )
  }

  {/* Recent Blog Essays Preview */}
  {
    recentPosts.length > 0 ? (
      <section class="home-section" aria-labelledby="recent-essays-heading">
        <div class="section-header">
          <div>
            <span class="section-kicker">Game Design & Fiction</span>
            <h2 id="recent-essays-heading" class="section-title">Recent Essays & Reviews</h2>
          </div>
          <a href={withBase('/blog')} class="section-link" id="view-all-essays-link">
            All essays & reviews ({allPosts.length}) →
          </a>
        </div>

        <div class="blog-list">
          {
            recentPosts.map((post) => (
              <BlogCard
                id={post.id}
                title={post.data.title}
                description={post.data.description}
                pubDate={post.data.pubDate}
                category={post.data.category}
                readingTime={post.data.readingTime}
                subjectTitle={post.data.subjectTitle}
                subjectCreator={post.data.subjectCreator}
                externalUrl={post.data.externalUrl}
                externalPlatform={post.data.externalPlatform}
              />
            ))
          }
        </div>
      </section>
    ) : (
      <section class="home-section home-section--empty">
        <div class="section-header">
          <div>
            <span class="section-kicker">Writing & Criticism</span>
            <h2 id="recent-essays-heading" class="section-title">Essays & Reviews Forthcoming</h2>
          </div>
        </div>
        <div class="empty-state-box">
          <p class="empty-state-box__text">
            Essays on game mechanics, narrative architecture, and fiction reviews are in the draft stage and will appear here shortly.
          </p>
          <div class="empty-state-box__links">
            <a href="https://substack.com" target="_blank" rel="noopener noreferrer" class="synd-pill">
              Substack ↗
            </a>
            <a href="https://medium.com" target="_blank" rel="noopener noreferrer" class="synd-pill">
              Medium ↗
            </a>
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero {
    padding: 1rem 0 0.5rem;
  }

  .hero__kicker {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--accent-green);
    margin-bottom: 0.65rem;
    font-weight: 500;
  }

  .hero__title {
    margin-bottom: 0.45rem;
  }

  .hero__subtitle {
    font-family: var(--font-serif);
    font-size: clamp(1.15rem, 2.2vw, 1.38rem);
    color: var(--text-muted);
    font-style: italic;
    margin-bottom: 1.5rem;
  }

  .hero__bio {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    font-size: 1.04rem;
    line-height: 1.72;
    max-width: 74ch;
    margin-bottom: 2rem;
  }

  .pillars-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    padding: 1.25rem 0;
    border-top: 1px solid var(--border-subtle);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: 1.5rem;
  }

  .pillar-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
  }

  .pillar-index {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent-gold);
    font-weight: 600;
    margin-top: 0.15rem;
  }

  .pillar-title {
    font-family: var(--font-sans);
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .pillar-detail {
    font-size: 0.82rem;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .socials-bar {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    flex-wrap: wrap;
  }

  .socials-bar__label {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--text-muted);
  }

  .socials-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    list-style: none;
  }

  .social-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    padding: 0.32rem 0.68rem;
    border-radius: var(--radius-sm);
    background-color: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    transition: border-color var(--transition-fast), color var(--transition-fast), background-color var(--transition-fast);
  }

  .social-pill:hover {
    border-color: var(--accent-green);
    color: var(--accent-green);
    background-color: var(--accent-green-soft);
  }

  .gateway-card__count {
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: var(--text-muted);
  }

  .home-section {
    margin-bottom: 3.5rem;
  }

  .projects-stack {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.15rem;
  }

  .empty-state-box {
    background-color: var(--bg-elevated);
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-md);
    padding: 1.75rem;
  }

  .empty-state-box__text {
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--text-secondary);
    margin-bottom: 1rem;
    max-width: 65ch;
  }

  .empty-state-box__links {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .synd-pill {
    font-family: var(--font-mono);
    font-size: 0.76rem;
    padding: 0.35rem 0.7rem;
    border-radius: 4px;
    background-color: var(--accent-gold-soft);
    color: var(--accent-gold);
    font-weight: 500;
  }

  .synd-pill:hover {
    background-color: var(--accent-green-soft);
    color: var(--accent-green);
  }

  @media (max-width: 740px) {
    .pillars-grid {
      grid-template-columns: 1fr;
      gap: 0.9rem;
    }
  }
</style>
